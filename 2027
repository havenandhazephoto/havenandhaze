<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Haven & Haze | Wedding Photography & Videography</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;1,300;1,400&family=Cinzel:wght@400;500&family=Jost:wght@200;300;400&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

  :root {
    --cream: #F7F3EE;
    --warm-white: #FDFAF6;
    --stone: #C5B8A8;
    --deep: #2C2420;
    --mid: #6B5C52;
    --accent: #A8896C;
    --light-stone: #E8E0D6;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: 'Jost', sans-serif;
    background: var(--warm-white);
    color: var(--deep);
    font-weight: 300;
    overflow-x: hidden;
  }

  /* NAV */
  nav {
    position: fixed;
    top: 0; left: 0; right: 0;
    z-index: 100;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 60px;
    transition: background 0.4s, padding 0.4s;
  }
  nav.scrolled {
    background: rgba(253,250,246,0.96);
    backdrop-filter: blur(8px);
    padding: 16px 60px;
    border-bottom: 1px solid var(--light-stone);
  }
  .nav-logo {
    font-family: 'Cinzel', serif;
    font-size: 1.25rem;
    font-weight: 400;
    letter-spacing: 0.12em;
    color: var(--warm-white);
    text-decoration: none;
    transition: color 0.4s;
  }
  nav.scrolled .nav-logo { color: var(--deep); }
  .nav-links { display: flex; gap: 36px; list-style: none; }
  .nav-links a {
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.85);
    text-decoration: none;
    transition: color 0.3s;
  }
  nav.scrolled .nav-links a { color: var(--mid); }
  .nav-links a:hover { color: var(--accent); }

  /* HERO */
  .hero {
    height: 100vh;
    min-height: 700px;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    overflow: hidden;
  }
    .hero-bg {
    position: absolute;
    inset: 0;
    background-image: url('data:image/jpeg;base64,');
    background-size: cover;
    background-position: center top;
    filter: brightness(0.38);
  }
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 40%, rgba(168,137,108,0.15) 0%, transparent 65%);
    z-index: 1;
  }
  .hero-content {
    position: relative;
    z-index: 2;
    animation: fadeUp 1.2s ease both;
  }
  .hero-eyebrow {
    font-size: 0.65rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: 28px;
    opacity: 0;
    animation: fadeUp 1s 0.3s ease both;
  }
  .hero h1 {
    font-family: 'Cinzel', serif;
    font-size: clamp(2.6rem, 6.5vw, 5.5rem);
    font-weight: 400;
    color: var(--warm-white);
    line-height: 1.0;
    letter-spacing: 0.06em;
    opacity: 0;
    animation: fadeUp 1s 0.5s ease both;
  }
  .hero h1 em {
    font-style: italic;
    color: var(--stone);
    font-family: 'Cinzel', serif;
  }
  .hero-sub {
    font-size: 0.75rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(197,184,168,0.7);
    margin-top: 24px;
    opacity: 0;
    animation: fadeUp 1s 0.7s ease both;
  }
  .hero-cta {
    margin-top: 52px;
    opacity: 0;
    animation: fadeUp 1s 0.9s ease both;
  }
  .btn {
    display: inline-block;
    padding: 16px 44px;
    border: 1px solid rgba(197,184,168,0.5);
    color: var(--warm-white);
    font-family: 'Jost', sans-serif;
    font-size: 0.7rem;
    font-weight: 300;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background 0.3s, border-color 0.3s, color 0.3s;
    cursor: pointer;
    background: transparent;
  }
  .btn:hover {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--warm-white);
  }
  .btn-dark {
    border-color: var(--accent);
    color: var(--deep);
  }
  .btn-dark:hover { background: var(--deep); border-color: var(--deep); color: var(--warm-white); }

  .scroll-indicator {
    position: absolute;
    bottom: 40px;
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    opacity: 0;
    animation: fadeIn 1s 1.4s ease both;
    z-index: 2;
  }
  .scroll-line {
    width: 1px;
    height: 50px;
    background: linear-gradient(to bottom, transparent, var(--stone));
    animation: scrollPulse 2s infinite;
  }
  .scroll-text {
    font-size: 0.6rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--stone);
  }

  /* SECTIONS */
  section { padding: 120px 60px; }

  .section-label {
    font-size: 0.6rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 16px;
  }
  .section-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 300;
    line-height: 1.15;
    color: var(--deep);
  }
  .section-title em { font-style: italic; color: var(--accent); }

  /* ABOUT */
  .about-section { background: var(--cream); }
  .about {
    max-width: 1100px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: center;
  }
  .about-text p {
    font-size: 1.05rem;
    line-height: 1.9;
    color: var(--mid);
    margin-top: 28px;
    font-weight: 300;
  }
  .about-img {
    position: relative;
    overflow: hidden;
    aspect-ratio: 3/4;
  }
  .about-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .about-img::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 40%;
    background: linear-gradient(to top, rgba(44,36,32,0.3), transparent);
  }

  /* SERVICES */
  .services-section { background: var(--warm-white); }
  .services-inner { max-width: 1200px; margin: 0 auto; }
  .services-header { text-align: center; margin-bottom: 80px; }
  .services-header p {
    max-width: 540px;
    margin: 20px auto 0;
    color: var(--mid);
    font-size: 0.95rem;
    line-height: 1.8;
  }
  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2px;
  }
  .service-card {
    background: var(--cream);
    padding: 52px 40px;
    position: relative;
    overflow: hidden;
    transition: background 0.4s;
  }
  .service-card::before {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transition: transform 0.4s;
    transform-origin: left;
  }
  .service-card:hover::before { transform: scaleX(1); }
  .service-card:hover { background: #EDE5DA; }

  /* Rising sun SVG icon */
  .sun-icon {
    width: 36px;
    height: 36px;
    margin-bottom: 28px;
    color: var(--accent);
  }

  .service-card h3 {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.6rem;
    font-weight: 400;
    color: var(--deep);
    margin-bottom: 16px;
  }
  .service-card p {
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--mid);
  }

  /* PACKAGES */
  .packages-section { background: var(--deep); }
  .packages-inner { max-width: 1300px; margin: 0 auto; }
  .packages-header { text-align: center; margin-bottom: 60px; }
  .packages-header .section-label { color: var(--stone); }
  .packages-header .section-title { color: var(--warm-white); }
  .packages-header p { color: rgba(197,184,168,0.7); margin-top: 16px; font-size: 0.85rem; letter-spacing: 0.05em; }

  .packages-tabs {
    display: flex;
    justify-content: center;
    gap: 0;
    margin-bottom: 48px;
    border: 1px solid rgba(197,184,168,0.25);
    width: fit-content;
    margin-left: auto;
    margin-right: auto;
  }
  .pkg-tab {
    padding: 12px 40px;
    font-size: 0.65rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: rgba(197,184,168,0.6);
    cursor: pointer;
    transition: all 0.3s;
    border: none;
    background: transparent;
    font-family: 'Jost', sans-serif;
  }
  .pkg-tab.active {
    background: var(--accent);
    color: var(--warm-white);
  }
  .pkg-tab:not(.active):hover { color: var(--stone); }

  .packages-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
  }
  .pkg-panel { display: none; }
  .pkg-panel.active { display: block; }

  .pkg-card {
    border: 1px solid rgba(197,184,168,0.2);
    padding: 44px 28px;
    position: relative;
    transition: border-color 0.3s, transform 0.3s;
  }
  .pkg-card:hover { border-color: var(--accent); transform: translateY(-4px); }
  .pkg-card.featured {
    border-color: var(--accent);
    background: rgba(168,137,108,0.08);
  }
  .pkg-featured-badge {
    position: absolute;
    top: -1px; left: 50%; transform: translateX(-50%);
    background: var(--accent);
    color: var(--warm-white);
    font-size: 0.55rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    padding: 5px 18px;
    white-space: nowrap;
  }
  .pkg-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--warm-white);
    margin-bottom: 6px;
  }
  .pkg-subtitle {
    font-size: 0.58rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: 28px;
  }
  .pkg-from {
    font-size: 0.6rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: 4px;
  }
  .pkg-price {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 300;
    color: var(--accent);
    margin-bottom: 28px;
    line-height: 1;
  }
  .pkg-features {
    list-style: none;
    margin-bottom: 32px;
  }
  .pkg-features li {
    font-size: 0.75rem;
    color: rgba(197,184,168,0.75);
    padding: 6px 0;
    border-bottom: 1px solid rgba(197,184,168,0.1);
    display: flex;
    align-items: flex-start;
    gap: 8px;
    line-height: 1.5;
  }
  .pkg-features li::before {
    content: '—';
    color: var(--accent);
    flex-shrink: 0;
    font-size: 0.7rem;
  }
  .pkg-cta {
    display: block;
    text-align: center;
    padding: 12px 24px;
    border: 1px solid rgba(197,184,168,0.3);
    color: var(--stone);
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    transition: all 0.3s;
  }
  .pkg-cta:hover, .pkg-card.featured .pkg-cta {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--warm-white);
  }

  /* TEAM */
  .team-section { background: var(--cream); }
  .team-inner { max-width: 1100px; margin: 0 auto; }
  .team-header { margin-bottom: 72px; }
  .team-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 48px; }
  .team-card { text-align: center; }
  .team-photo {
    width: 240px;
    height: 240px;
    border-radius: 50%;
    margin: 0 auto 28px;
    overflow: hidden;
    position: relative;
    border: 1px solid rgba(168,137,108,0.3);
  }
  .team-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }
  .team-name {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--deep);
    margin-bottom: 6px;
  }
  .team-role {
    font-size: 0.6rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--accent);
    margin-bottom: 20px;
  }
  .team-bio {
    font-size: 0.85rem;
    line-height: 1.8;
    color: var(--mid);
  }

  /* CONTACT */
  .contact-section { background: var(--warm-white); }
  .contact-inner {
    max-width: 900px;
    margin: 0 auto;
  }
  .contact-top {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 80px;
    align-items: start;
    margin-bottom: 0;
  }
  .contact-info h2 {
    font-family: 'Cormorant Garamond', serif;
    font-size: clamp(2rem, 3.5vw, 3rem);
    font-weight: 300;
    line-height: 1.2;
    color: var(--deep);
    margin-bottom: 28px;
  }
  .contact-info h2 em { font-style: italic; color: var(--accent); }
  .contact-info p {
    font-size: 0.9rem;
    line-height: 1.9;
    color: var(--mid);
    margin-bottom: 40px;
  }
  .contact-detail {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  .contact-item {
    display: flex;
    align-items: flex-start;
    gap: 16px;
  }
  .contact-item-icon {
    font-size: 1rem;
    color: var(--accent);
    margin-top: 2px;
    flex-shrink: 0;
  }
  .contact-item-label {
    font-size: 0.58rem;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: var(--stone);
    margin-bottom: 3px;
  }
  .contact-item-value {
    font-size: 0.88rem;
    color: var(--deep);
    font-weight: 300;
  }
  .contact-item-value a {
    color: var(--deep);
    text-decoration: none;
  }
  .contact-item-value a:hover { color: var(--accent); }

  /* Google Form embed */
  .form-container {
    margin-top: 0;
  }
  .gform-wrapper {
    width: 100%;
    border: 1px solid var(--light-stone);
    background: var(--cream);
  }
  .gform-wrapper iframe {
    width: 100%;
    height: 900px;
    border: none;
    display: block;
  }

  /* DIVIDER */
  .divider {
    width: 48px;
    height: 1px;
    background: var(--accent);
    margin: 28px 0;
  }

  /* FOOTER */
  footer {
    background: var(--deep);
    padding: 60px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 24px;
  }
  .footer-logo {
    font-family: 'Cinzel', serif;
    font-size: 1.4rem;
    font-weight: 400;
    color: var(--warm-white);
    letter-spacing: 0.1em;
  }
  .footer-partner {
    font-family: 'Cinzel', serif;
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    color: var(--stone);
    margin-top: 6px;
  }
  .footer-copy {
    font-size: 0.65rem;
    letter-spacing: 0.1em;
    color: rgba(197,184,168,0.5);
  }
  .footer-links { display: flex; gap: 28px; }
  .footer-links a {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: rgba(197,184,168,0.6);
    text-decoration: none;
    transition: color 0.3s;
  }
  .footer-links a:hover { color: var(--accent); }

  /* ANIMATIONS */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(24px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes scrollPulse {
    0%, 100% { opacity: 0.4; }
    50% { opacity: 1; }
  }
  .reveal {
    opacity: 0;
    transform: translateY(30px);
    transition: opacity 0.8s ease, transform 0.8s ease;
  }
  .reveal.visible {
    opacity: 1;
    transform: translateY(0);
  }

  /* MOBILE */
  @media (max-width: 900px) {
    nav { padding: 20px 24px; }
    nav.scrolled { padding: 14px 24px; }
    .nav-links { display: none; }
    section { padding: 80px 24px; }
    .about { grid-template-columns: 1fr; gap: 40px; }
    .services-grid { grid-template-columns: 1fr; gap: 2px; }
    .packages-grid { grid-template-columns: 1fr 1fr; }
    .team-grid { grid-template-columns: 1fr; gap: 40px; }
    .contact-top { grid-template-columns: 1fr; gap: 48px; }
    footer { flex-direction: column; text-align: center; padding: 40px 24px; }
    .footer-links { flex-wrap: wrap; justify-content: center; }
  }
  @media (max-width: 600px) {
    .packages-grid { grid-template-columns: 1fr; }
    .hero h1 { font-size: 3rem; }
  }
  /* Services prose */
  .services-prose {
    max-width: 760px;
    margin: 0 auto 60px;
    text-align: center;
  }
  .services-prose p {
    font-size: 1.05rem;
    line-height: 1.8;
    color: var(--bark);
    margin-bottom: 16px;
  }
  .services-disclaimer {
    font-size: 0.9rem !important;
    color: var(--stone) !important;
    border-top: 1px solid var(--stone);
    padding-top: 16px;
    margin-top: 8px;
  }
  @media (max-width: 768px) {

  /* ── BOOKING PROCESS ── */
  .booking-section {
    padding: 100px 0;
    background: var(--cream);
  }
  .booking-inner {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .booking-header {
    text-align: center;
    margin-bottom: 60px;
  }
  .booking-steps {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .booking-steps::before {
    content: '';
    position: absolute;
    left: 32px;
    top: 20px;
    bottom: 20px;
    width: 1px;
    background: var(--stone);
    opacity: 0.35;
  }
  .booking-step {
    display: flex;
    align-items: flex-start;
    gap: 28px;
    padding: 20px 0;
  }
  .booking-step-num {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--stone);
    background: var(--cream);
    display: flex;
    align-items: center;
    justify-content: center;
    font-family: 'Cinzel', serif;
    font-size: 1rem;
    color: var(--bark);
    position: relative;
    z-index: 1;
  }
  .booking-step-content {
    padding-top: 16px;
  }
  .booking-step-title {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--bark);
    margin-bottom: 4px;
  }
  .booking-step-desc {
    font-size: 0.95rem;
    color: var(--stone);
    line-height: 1.6;
  }
  .booking-step--highlight .booking-step-num {
    background: var(--bark);
    color: var(--warm-white);
    border-color: var(--bark);
  }
  @media (max-width: 600px) {
    .booking-steps::before { left: 24px; }
    .booking-step-num { width: 48px; height: 48px; font-size: 0.85rem; }
    .booking-step { gap: 18px; }
    .booking-step-content { padding-top: 10px; }
  }


  /* ── VIDEO SECTION ── */
  .video-section {
    padding: 100px 0;
    background: var(--deep);
  }
  .video-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 24px;
  }
  .video-header {
    text-align: center;
    margin-bottom: 48px;
  }
  .video-header .section-label { color: var(--stone); }
  .video-header .section-title { color: var(--warm-white); }
  .video-header .section-title em { color: var(--stone); }
  .video-header p {
    color: var(--stone);
    font-size: 1rem;
    margin-top: 16px;
    line-height: 1.7;
  }
  .video-embed-wrapper {
    position: relative;
    padding-bottom: 56.25%; /* 16:9 */
    height: 0;
    overflow: hidden;
    border-radius: 4px;
    background: #1a1614;
  }
  .video-embed-wrapper iframe {
    position: absolute;
    top: 0; left: 0;
    width: 100%;
    height: 100%;
    border: none;
  }
  .video-placeholder {
    position: absolute;
    top: 0; left: 0;
    width: 100%; height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 16px;
    color: var(--stone);
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    letter-spacing: 0.06em;
    background: rgba(30,24,20,0.85);
  }
  .video-placeholder svg { opacity: 0.5; }
  .video-caption {
    text-align: center;
    margin-top: 20px;
    font-size: 0.85rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--stone);
  }


    /* ── Recent Work Gallery ── */
    .work-section {
      padding: 80px 0 90px;
      background: #F7F3EE;
